# Where the SQLite database lives. On Railway, mount a volume at /data.
DATA_DIR=/data
# 64+ random characters. If unset, one is generated and stored in DATA_DIR.
JWT_SECRET=
# Optional fixed setup code for first run (otherwise a random one is printed to the logs).
SETUP_CODE=
# Public URL used in buzzer links / QR codes, e.g. https://buzz.example.com
PUBLIC_URL=
# Optional free email alerts using your own mailbox (e.g. Gmail + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: pin Web Push keys (otherwise generated and stored in DATA_DIR)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
